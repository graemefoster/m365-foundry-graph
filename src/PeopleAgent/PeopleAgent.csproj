    <ProjectReference Include="../PeopleAgent.Core/PeopleAgent.Core.csproj" />
    <ProjectReference Include="../PeopleAgent.ActivityProtocol/PeopleAgent.ActivityProtocol.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="PeopleAgent.Core" />
  </ItemGroup>
  <ItemGroup>
    <Content Update="Data/**/*.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Data/**/*.txt;Data/**/*.jsonl" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
