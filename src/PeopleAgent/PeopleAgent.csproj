<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- Host: composes Core with the Activity Protocol adapter and Agent Framework Responses hosting; also hosts dev/eval tools. -->
  <PropertyGroup>
    <UserSecretsId>8084a5ab-ae6d-489c-89a2-1e2978d51814</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <Content Update="appsettings.Local.json" CopyToPublishDirectory="Never" />
