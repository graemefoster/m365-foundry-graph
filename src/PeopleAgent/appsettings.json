{
  "Demo": {
    "TimeZone": "Australia/Sydney",
    "SessionTimeoutMinutes": 720,
    "StorageDirectory": ".local",
    "SensitiveTopicPattern": "\\b(harass(?:ment|ed|ing)?|bully(?:ing)?|discriminat\\w*|domestic\\s+(?:violence|abuse)|self[- ]?harm|suicid\\w*|kill\\s+myself|hurt\\s+myself|financial\\s+hardship|burn(?:t|ed)?\\s*out|burnout|overwhelmed)\\b"
  },
  "AgentApplication": {
    "StartTypingTimer": false,
    "RemoveRecipientMention": true,
    "NormalizeMentions": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Agents": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  }
}
